# Copy to .env.local. Never commit .env.local.

# Neon Postgres. Use a Neon BRANCH for local work — the project's main database is production,
# and `npm run db:seed -- --yes-wipe` truncates whatever this points at.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection for migrations / drizzle-kit (optional; falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=

# Password the seed gives the platform admin (admin@calltime.dev). Random + printed if unset.
SEED_ADMIN_PASSWORD=

# Web push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public base URL for invite, reset and calendar links. Set in production.
APP_URL=http://localhost:3000

# Shows one-tap demo sign-in in production (always on in development).
DEMO_MODE=

# Transactional email (optional): password reset and the weekly digest.
RESEND_API_KEY=
RESEND_FROM=
